# Copy to .env for local development. Every value here is a fake placeholder.
# Never commit a real .env file.

ENVIRONMENT=development

# sqlite for a quick local run; use the docker-compose Postgres for anything serious:
#   DATABASE_URL=postgresql://buffer:buffer@localhost:5432/buffer
DATABASE_URL=sqlite:///./dev.db
APPLICATION_BASE_URL=http://localhost:8000

# Generate both with: python -m project_buffer.cli generate-keys
SECRET_KEY=replace-with-output-of-generate-keys-0000000000000000
RAW_MESSAGE_ENCRYPTION_KEY=replace-with-output-of-generate-keys
# Comma-separated retired keys, kept only so old rows still decrypt after a rotation.
RAW_MESSAGE_ENCRYPTION_KEYS_OLD=

# "console" sends nothing and accepts no webhooks. Production requires "twilio".
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
# E.164 format. These three numbers must all differ. 555-01xx numbers are fictional.
TWILIO_PHONE_NUMBER=+12025550100
COPARENT_PHONE_NUMBER=+12025550101
OWNER_PHONE_NUMBER=+12025550102

# Names used in summaries and drafts. Not real names in this file.
COPARENT_DISPLAY_NAME=Jordan
OWNER_DISPLAY_NAME=Alex
CHILDREN_NAMES=Riley, Sam
OWNER_TIMEZONE=America/New_York
# Shown on the public /privacy and /terms pages. Must match the A2P brand name.
SMS_BRAND_NAME=Alex Example
# Optional. What a caller hears; calls are never connected. Leave unset for the default.
# VOICE_GREETING=

# "fake" does no AI filtering and is refused in production. Use anthropic or openai.
LLM_PROVIDER=fake
# Leave blank for the provider's default model.
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Owner notifications: summary | link_only | off
NOTIFY_MODE=summary
NOTIFY_EMERGENCY_REPEAT_MINUTES=5
NOTIFY_EMERGENCY_MAX_REPEATS=2
NOTIFY_UNRECOGNIZED_SENDERS=true
# Neutral "received, filtering delayed" notice after this many minutes unprocessed.
PROCESSING_DELAY_NOTICE_MINUTES=5

LOG_LEVEL=INFO
